# Copy to .env for local use. Never commit real values.

PORT=8787

# BSC testnet RPC. Required: the round is read from the chain. This server runs on chain 97 only and
# refuses to start with any other CHAIN_ID.
RPC_URL=
CHAIN_ID=97

# The attester key. It signs daily check-ins, so it must be the key of the address the round was
# created with as `attester`, and it sends OriginRegistry.setOrigin (see ORIGIN_REGISTRY). Unless
# FAUCET_PRIVATE_KEY is set, its wallet also pays the faucet's gas transfers. Without it the server
# still answers GET requests, but POST /checkin answers 503 and nothing is announced.
# Use a throwaway testnet key; never commit it. VERIFIER_PRIVATE_KEY (the earlier name) is read too.
ATTESTER_PRIVATE_KEY=

# The featured round: the address of one CheckInLauncher. It is the round /round, /me, /members and
# /checkin serve, and the first one in GET /rounds. Leave empty to start with no featured round
# (GET /round answers 404 no_round). POST /admin/round sets another one without a restart; a round
# set that way is stored in DATA_FILE and wins over this value from then on.
CURRENT_LAUNCHER=
# Optional display name. Empty means the name stored in the Launcher.
CURRENT_ROUND_NAME=

# Shared secret for POST /admin/round (Authorization: Bearer <token>). Without it that route is off.
ADMIN_TOKEN=change-me

# Steps a member must report for a day to check in (1 to 80000).
MIN_STEPS=1000

# true: also accept step counts the member typed in (source "self"). For the testnet demo on the
# web, where there is no health data to read. They are stored flagged as self-reported.
ALLOW_SELF_REPORTED=false

# Faucet: POST /faucet sends FAUCET_DRIP_BNB test BNB (gas only, no test USD) to a new wallet, once
# per address (200 wallets in total, FAUCET_PER_IP_PER_HOUR per network address per hour). Needs
# FAUCET_PRIVATE_KEY or ATTESTER_PRIVATE_KEY. Off unless set to true.
FAUCET_ENABLED=false
# Wallets one network address may get funded in an hour (1 to 1000). A room of people on one Wi-Fi
# shares one address, so raise it for an event. Default 5.
# FAUCET_PER_IP_PER_HOUR=5
# Test BNB sent per wallet, as a decimal (above 0, at most 1). Default 0.03.
# FAUCET_DRIP_BNB=0.03
# Optional. A separate throwaway testnet key for the faucet. When set the faucet pays from this
# wallet (fund it with test BNB) and the attester key only signs check-ins and announces the
# origin. Never commit it.
FAUCET_PRIVATE_KEY=
# true when a reverse proxy is in front of this server: the faucet's per-IP limit then uses the last
# address in X-Forwarded-For. Leave false when clients connect directly.
TRUST_PROXY=false

# Optional. Address of a token's page on Flap, with {token} where the token address goes. When set,
# GET /round returns it as flapUrl once the round has launched; otherwise flapUrl is null.
FLAP_TOKEN_URL=

# Where the JSON store is kept: the featured round, the rounds found on chain, the creators'
# listed/unlisted choices, the members seen, accepted check-ins and the faucet record.
DATA_FILE=./data/store.json

# Which rounds exist: every CheckInLauncher our factory created, read from the factory's creation
# events. All four are optional; the defaults are the factory deployed on BSC testnet.
# LAUNCHER_FACTORY=0x2A872200B83dD025977d785cDE05356d23eA4153
# The block the factory was deployed in; the scan starts there.
# FACTORY_FROM_BLOCK=144816444
# Blocks per eth_getLogs call. A range the RPC refuses is halved and asked again.
# LOG_CHUNK_BLOCKS=10000
# How often the server looks for newly created rounds.
# ROUNDS_REFRESH_SECONDS=10

# Origin announcer. When ORIGIN_REGISTRY is set (with ATTESTER_PRIVATE_KEY), every
# ORIGIN_CHECK_SECONDS the server finds its public host and, when OriginRegistry.origin() differs,
# sends setOrigin(host) from the attester key (legacy, 1 gwei, gas limit 200,000). The apps read
# the host from that registry. The OriginRegistry on BSC testnet:
# ORIGIN_REGISTRY=0xb9aD45Dc177C801f10670F2aac03B467f1C367d2
ORIGIN_REGISTRY=
# The host, when it is fixed (a plain hostname such as api.example.com, no scheme or path). When
# empty the host is read from ORIGIN_SOURCE_URL.
ORIGIN_HOST=
# cloudflared's metrics server, which answers {"hostname":"<name>.trycloudflare.com"} for a quick
# tunnel. The default is the tunnel container of deploy/docker-compose.yml.
# ORIGIN_SOURCE_URL=http://tunnel:20241/quicktunnel
# How often the host is checked (10 to 3600). Default 60.
# ORIGIN_CHECK_SECONDS=60
