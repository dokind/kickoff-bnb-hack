# Copy to .env for local use. Never commit real values.

PORT=8787

# BSC testnet RPC. Required: the round is read from the chain. This server runs on chain 97 only and
# refuses to start with any other CHAIN_ID.
RPC_URL=
CHAIN_ID=97

# The attester key. It signs daily check-ins, so it must be the key of the address the round was
# created with as `attester`. Its wallet also pays the faucet's gas transfers. Without it the server
# still answers GET requests, but POST /checkin answers 503 and the faucet is off.
# Use a throwaway testnet key; never commit it. VERIFIER_PRIVATE_KEY (the earlier name) is read too.
ATTESTER_PRIVATE_KEY=

# The round this server serves: the address of one CheckInLauncher. Leave empty to start with no
# round (GET /round answers 404 no_round). POST /admin/round sets another one without a restart;
# a round set that way is stored in DATA_FILE and wins over this value from then on.
CURRENT_LAUNCHER=
# Optional display name. Empty means the name stored in the Launcher.
CURRENT_ROUND_NAME=

# Shared secret for POST /admin/round (Authorization: Bearer <token>). Without it that route is off.
ADMIN_TOKEN=change-me

# Steps a member must report for a day to check in (1 to 80000).
MIN_STEPS=1000

# true: also accept step counts the member typed in (source "self"). For the testnet demo on the
# web, where there is no health data to read. They are stored flagged as self-reported.
ALLOW_SELF_REPORTED=false

# Faucet: POST /faucet sends 0.03 test BNB (gas only, no test USD) from the attester wallet to a new
# wallet, once per address (200 wallets in total, 5 per IP per hour). Needs ATTESTER_PRIVATE_KEY.
# Off unless set to true.
FAUCET_ENABLED=false
# true when a reverse proxy is in front of this server: the faucet's per-IP limit then uses the last
# address in X-Forwarded-For. Leave false when clients connect directly.
TRUST_PROXY=false

# Optional. Address of a token's page on Flap, with {token} where the token address goes. When set,
# GET /round returns it as flapUrl once the round has launched; otherwise flapUrl is null.
FLAP_TOKEN_URL=

# Where the JSON store is kept: the current round, the members seen, accepted check-ins and the
# faucet record.
DATA_FILE=./data/store.json
