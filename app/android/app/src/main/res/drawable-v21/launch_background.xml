<?xml version="1.0" encoding="utf-8"?>
<!-- Launch screen: the app's deepest ink (AppColors.inkDeep), so there is no
     white flash before Flutter draws its first frame. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF05080A"/>
        </shape>
    </item>
</layer-list>
