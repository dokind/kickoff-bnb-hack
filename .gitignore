# Secrets: never commit keys or filled-in env files
.env
.env.*
!.env.example
*.pem
*.key
*.keystore
*.jks
key.properties

# Dependencies
node_modules/
contracts/lib/
.dart_tool/
.pub-cache/
app/ios/Pods/
app/.flutter-plugins-dependencies

# Build output and caches
dist/
build/
contracts/out/
contracts/cache/
contracts/broadcast/
coverage/

# Local data written by the verifier
verifier/data/

# Editor and OS noise
.DS_Store
.idea/
*.iml

# Server details and local run state: not for the public repo
HOSTING.md
scripts/*-run.json
scripts/*-result.json

# Flap media kit originals: link to the source instead of redistributing
app/assets/brand/original/

.vercel/

# Rendered demo videos (large files): shared outside git
pitch-video/*.mp4

# Pitch video scratch: candidate voice takes, downloaded deck videos, renders
pitch-video/cand/
pitch-video/deck-videos/
pitch-video/vo-mine/
pitch-video/vo-ref/
pitch-video/listen-*.mp3
