# Copy to .env and fill in. .env is git-ignored. Never commit a real key.

# BNB Testnet (chain 97) RPC. Needed by the fork tests and the deploy script.
# The public nodes work for a single run but rate limit; a provider key is more reliable.
#   https://bsc-testnet-rpc.publicnode.com
#   https://bsc-testnet-dataseed.bnbchain.org
BSC_TESTNET_RPC_URL=

# Deployer key for script/Deploy.s.sol. Use a throwaway testnet wallet holding a little tBNB.
PRIVATE_KEY=

# Optional: ERC-20 the deposit is paid in. Defaults to Flap's test USD on BNB Testnet.
# QUOTE_TOKEN=0x190C989D5665a0e404B444b53CAE9AbCfb600157
